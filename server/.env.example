# CMS / API — copy to server/.env for local use.
# On Vercel, set these on project gpwebsite-v2-api (do not commit real values).

# ─── Storage ───
# json     = server/data/cms.json  (local / VPS default)
# blobs    = Netlify Blobs         (auto on Netlify)
# mongodb  = MongoDB Atlas         (required for Vercel so edits persist)
# memory   = ephemeral process memory (lost on cold start — do not use in production)
CMS_STORAGE=json

# When CMS_STORAGE=mongodb (or when MONGODB_URI is set and CMS_STORAGE is unset):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gp_pharmacy?retryWrites=true&w=majority
# MONGODB_DB=gp_pharmacy
# MONGODB_COLLECTION=cms
# MONGODB_DOC_ID=cms-main
# MONGODB_MEDIA_BUCKET=cms_uploads

# Log which storage is active on each load (optional)
# CMS_STORAGE_LOG=1

# Required on Vercel / production. Random string, 32+ characters.
# Example format (not a real secret): openssl rand -hex 32
JWT_SECRET=

# Optional token lifetime (default 4h). Stateless JWT — no server session store.
JWT_EXPIRY=4h

# Comma-separated browser origins allowed to call the API.
# Production site: https://gpwebsite-v2.vercel.app
# *.vercel.app is also allowed while the API itself runs on Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gpwebsite-v2.vercel.app

# Public API origin (uploads are served as /uploads/<file> on this host)
PUBLIC_URL=http://localhost:3001

# Used only when the database has no users yet. Later deploys do not reset passwords.
CMS_ADMIN_PASSWORD=
CMS_EDITOR_PASSWORD=

# Optional Cloudinary. When unset and CMS_STORAGE=mongodb, images are stored in GridFS.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=gp-pharmacy
