# CMS / API — copy to server/.env and fill real values for production

# ─── Storage (ONE place to change later for cloud database) ───
# json     = server/data/cms.json  (default local / VPS)
# blobs    = Netlify Blobs         (auto on Netlify)
# mongodb  = Cloud MongoDB         (set MONGODB_URI below)
CMS_STORAGE=json

# When CMS_STORAGE=mongodb:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=gp_pharmacy
# MONGODB_COLLECTION=cms
# MONGODB_DOC_ID=cms-main

# Log which storage is active on each load (optional)
# CMS_STORAGE_LOG=1

# Required in production (long random string, 32+ chars)
JWT_SECRET=

# Optional token lifetime (default 4h)
JWT_EXPIRY=4h

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public site URL (used for absolute upload URLs if needed)
PUBLIC_URL=http://localhost:3001

# Only used when seeding empty user list (change immediately after first deploy)
CMS_ADMIN_PASSWORD=
CMS_EDITOR_PASSWORD=

# Optional Cloudinary for image hosting
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=gp-pharmacy
