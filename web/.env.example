# Website (Vite) — copy to web/.env.local for local overrides.
# On Vercel project gpwebsite-v2, set this BEFORE the production build.
# Vite inlines it at build time; changing it later requires a redeploy.

# Local dual-server setup uses the Vite proxy and can leave this empty.
# Production: the public site and the API are different hosts.
VITE_CMS_API_URL=https://gpwebsite-v2-api.vercel.app
