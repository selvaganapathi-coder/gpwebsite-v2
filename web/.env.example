# Website (Vite) — copy to web/.env.local if the API is on another host

# Leave empty when site and API share the same domain (Netlify / same origin).
# Local dual-server setup usually uses Vite proxy (no value needed).
# If Admin is hosted separately from the API, set the full API origin:
# VITE_CMS_API_URL=https://api.your-college-domain.com
VITE_CMS_API_URL=
