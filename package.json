{
  "name": "gp-pharmacy-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:netlify": "npm install --prefix server && npm install --prefix web && npm run build --prefix web",
    "dev:web": "npm run dev --prefix web",
    "dev:cms": "npm start --prefix server",
    "deploy": "netlify deploy --prod --build",
    "cms:status": "npm run cms:status --prefix server",
    "cms:export": "npm run cms:export --prefix server",
    "cms:to-mongo": "npm run cms:to-mongo --prefix server"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "netlify-cli": "^27.8.0"
  }
}
